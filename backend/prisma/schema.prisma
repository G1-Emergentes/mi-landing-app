generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model StoreContact {
  id             Int      @id @default(autoincrement())
  storeName      String
  representative String
  email          String
  phone          String?
  websiteSocial  String?
  message        String
  createdAt      DateTime @default(now())
}

model TeamMember {
  id        Int      @id @default(autoincrement())
  name      String
  role      String
  imageUrl  String?
  bio       String?
  createdAt DateTime @default(now())
}

model Feature {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  icon        String?
  category    String?
  createdAt   DateTime @default(now())
}