# Puerto en el que corre el servidor backend (por defecto 3000)
PORT=3000

# Cadena de conexión a la base de datos PostgreSQL (Neon, Supabase o local)
# Formato: postgresql://<USUARIO>:<PASSWORD>@<HOST>/<DATABASE>?sslmode=require
DATABASE_URL="postgresql://usuario:password@ep-ejemplo.us-east-2.aws.neon.tech/neondb?sslmode=require"

